{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tpra.local/schemas/finding.json",
  "title": "TPRA Finding",
  "type": "object",
  "required": ["title", "severity", "category"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low", "info"]
    },
    "category": { "type": "string" },
    "source": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["valid", "exception", "pending_review", "approved", "rejected"]
    }
  }
}
