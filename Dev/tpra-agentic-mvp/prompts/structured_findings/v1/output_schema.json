{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["findings", "exceptions"],
  "properties": {
    "findings": {
      "type": "array",
      "items": { "$ref": "../../shared/tpra_schema.json" }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "message"],
        "properties": {
          "finding_id": { "type": ["string", "null"] },
          "field": { "type": "string" },
          "message": { "type": "string" },
          "severity": { "type": "string" }
        }
      }
    }
  }
}
