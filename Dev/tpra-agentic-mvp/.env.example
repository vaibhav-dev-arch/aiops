# TPRA Agentic MVP — environment template
# Copy to .env and adjust values.

TPRA_ENV=local
TPRA_CONFIG_PATH=backend/config.yaml
TPRA_DATA_DIR=.data
TPRA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Provider selection (local | azure)
STORAGE_PROVIDER=local
METADATA_PROVIDER=sqlite
LLM_PROVIDER=mock
AUTH_PROVIDER=dev
DOC_INTEL_PROVIDER=local

# Azure stubs (used when providers=azure)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_COSMOS_ENDPOINT=
AZURE_COSMOS_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_DOC_INTEL_ENDPOINT=
AZURE_DOC_INTEL_KEY=
